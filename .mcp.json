{
  "mcpServers": {
    "jira": {
      "command": "node",
      "args": ["${MCP_VISMA_JIRA_PATH}"],
      "env": {
        "JIRA_INTEGRATION_HUB_URL": "${JIRA_INTEGRATION_HUB_URL}",
        "JIRA_PERSONAL_ACCESS_TOKEN": "${JIRA_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "testomatio": {
      "command": "npx",
      "args": [
        "-y",
        "@testomatio/mcp@2.1.2",
        "--token",
        "${TESTOMATIO_API_TOKEN}",
        "--project",
        "e-conomic-web"
      ],
      "env": {
        "TESTOMATIO_BASE_URL": "https://app.testomat.io"
      }
    }
  }
}
