# Machine-local configuration — copy from the committed .example files
.env
.claude/qa-agent-config.jsonc

# Run outputs and caches (per-repo/per-branch state, never committed)
workspace/*
!workspace/.gitkeep
tools/*
!tools/.gitkeep

# Reports are local evidence for human review; keep the folder, ignore contents
reports/*
!reports/.gitkeep

# Local editor config — machine/IDE-specific, never shared
.vscode/

# Playwright MCP session artifacts (console logs, page snapshots, screenshots) —
# written to the repo root by the Playwright MCP server itself during qa-e2e-author's
# live-dev-stack exploration, never something agentQ or a developer authors
.playwright-mcp/

# OS noise
Thumbs.db
.DS_Store
