# agentQ secrets — copy to .env (gitignored) and fill in what you use.
# Every variable is optional: a missing value degrades the related lane honestly,
# it never blocks the rest of a review.

# ── Local dev stack (E2E lane, frontend branches) ─────────────────────────────
# Same conventions as manual-testing-ai-agents. Loopback hosts only — agentQ
# refuses to run E2E against anything that does not resolve to localhost.
LOCAL_DEV_URL=http://localhost:7080
LOCAL_DEV_CLIENT_URL=http://localhost:3000
LOCAL_DEV_AGREEMENT_NO=
LOCAL_DEV_USERNAME=

# ── Pact broker (contract lane, only if your team uses Pact) ──────────────────
# Read-only access. agentQ NEVER publishes verification results from a local run.
PACT_BROKER_BASE_URL=
PACT_BROKER_TOKEN=
