// agentQ config — copy to .claude/qa-agent-config.jsonc (gitignored, machine-local)
// and point the paths at your local checkouts.
{
  // GitHub slug → local checkout path. Read-only for agentQ.
  "productRepos": {
    "e-conomic/e-conomic": "<absolute path to your e-conomic checkout>",
    "e-conomic/client": "<absolute path to your client checkout>",
    "e-conomic/payroll-poc": "<absolute path to your payroll-poc checkout>",
    "e-conomic/Economic.ApiGateway": "<absolute path to your Economic.ApiGateway checkout>"
  },

  // One Jira project for all repos.
  "jiraProjectKey": "EC",

  // Test repos — scanned by the impact phase for affected tests. Never reviewed,
  // never built. Add future ones here (API testing, performance, …).
  // The Testomat lane also needs a Testomatio MCP in your Claude Code session
  // (token as an OS env var). Missing path or MCP → SKIPPED/DEGRADED in the report.
  "testRepos": {
    "e-conomic/ui-automation": "<absolute path to your ui-automation checkout>"
  },

  "toggles": {
    "mutationConsent": "ask",    // ask | always | never
    "executionConsent": "ask",   // ask | always | never
    "deepMutation": false,       // true = unscoped Stryker run (whole changed files)
    "skipQaImpact": false,       // true = skip the impact phase; /qa-impact always runs
    "e2eAuthoring": true,        // background E2E authoring on frontend branches
    "figmaConformance": true,    // compare against Figma frames linked in the ticket
    "reportVerbosity": "full"    // concise | full
  }
}
