// agentQ style anchor — NUnit 4 API test (WebApplicationFactory).
// qa-scenario-writer: replace every {{token}}; keep the structure and the category.
//
// TRAPS this file encodes — do not "clean up":
//  - NUnit 4 REMOVED the classic assert model. Assert.AreEqual / Assert.IsTrue /
//    Assert.IsNull DO NOT COMPILE. Constraint model ONLY:
//    Assert.That(actual, Is.EqualTo(expected)). Rendering classic asserts is the
//    #1 way a generated NUnit4 test breaks the build.
//  - NUnit is SHARED-INSTANCE: ONE instance of the [TestFixture] class runs ALL
//    its tests (the opposite of xUnit). Mutable instance fields leak state
//    between tests — keep fields readonly or reset them in [SetUp].
//  - ONE WebApplicationFactory per test ASSEMBLY via [SetUpFixture]. Placing the
//    [SetUpFixture] at the namespace ROOT makes it assembly-wide; per-fixture
//    boots multiply host builds (5s non-configurable host-build timeout →
//    false reds under load).
//  - UseKestrel(0) in the factory ctor, BEFORE first CreateClient()/Services —
//    after initialization it throws. Port 0 = ephemeral, loopback only.
//  - [Category], not [Trait] — run-tests.ps1 filters TestCategory=agentQ-generated.

using System.Net;
using System.Net.Http.Json;
using Microsoft.AspNetCore.Mvc.Testing;
using NUnit.Framework;

namespace {{TestRootNamespace}};   // root namespace → [SetUpFixture] covers the assembly

// ---- assembly-wide boot: exactly one app instance for every fixture ----------
[SetUpFixture]
public sealed class AgentQApiBoot
{
    public static WebApplicationFactory<{{TEntryPoint}}> Factory = null!;

    [OneTimeSetUp]
    public void BootOnce() => Factory = new AgentQFactory();

    [OneTimeTearDown]
    public void ShutDown() => Factory.Dispose();

    private sealed class AgentQFactory : WebApplicationFactory<{{TEntryPoint}}>
    {
        // Real Kestrel on an ephemeral port; MUST precede first initialization.
        public AgentQFactory() { UseKestrel(0); }
    }
}

[TestFixture]
[Category("agentQ-generated")]     // run-tests.ps1 filter: TestCategory=agentQ-generated
public sealed class {{TestClassName}}
{
    private HttpClient _client = null!;

    // NUnit shared-instance: this field is reset per test in [SetUp] so no
    // state leaks between tests sharing this single fixture instance.
    [SetUp]
    public void PerTest() => _client = AgentQApiBoot.Factory.CreateClient();

    // AC-{{n}}: {{verbatim acceptance-criterion text}}
    [Test]
    public async Task {{Endpoint}}_{{Scenario}}_{{ExpectedOutcome}}()
    {
        var response = await _client.PostAsJsonAsync("{{/api/route}}", new { {{concreteDomainPayload}} });

        // Constraint model ONLY — Assert.AreEqual would not compile on NUnit 4.
        // Non-vacuous by contract: fails on base if the AC's behavior regresses.
        Assert.That(response.StatusCode, Is.EqualTo(HttpStatusCode.{{ExpectedStatus}}));
        var body = await response.Content.ReadAsStringAsync();
        Assert.That(body, Does.Contain("{{expected-domain-detail}}"));
    }
}
